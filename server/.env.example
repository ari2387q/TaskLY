# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/skill-tracker
JWT_SECRET=your_jwt_secret_key_here

# Brevo (formerly Sendinblue) SMTP Configuration
# Get your free SMTP key from: https://app.brevo.com/settings/keys/smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_brevo_account_email@gmail.com
SMTP_PASS=xsmtpsib-your_brevo_smtp_master_key_here
EMAIL_FROM="TaskLY <your_verified_brevo_sender@gmail.com>"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
